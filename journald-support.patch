+        Map<String, Object> extras = new LinkedHashMap<>();
+        Level level;
+        String message;
+        String requestId = null;
+
+        LogEntry inner = tryFormats(body, false);
+        if (inner != null) {
+            extras.putAll(inner.extras);
+            level = inner.level;
+            message = inner.message;
